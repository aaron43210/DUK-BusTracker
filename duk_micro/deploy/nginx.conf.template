# /etc/nginx/sites-available/duk-bus
#
# DUK Bus Tracker — Dynamic Nginx reverse proxy configuration
# Generated by deploy.sh

# ── Passenger PWA ─────────────────────────────────────────────────────────────
server {
    listen ${PWA_PORT};
    server_name _;

    # Gzip compression (same settings as nginx-pwa.conf section 2)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml image/x-icon;

    # Legacy: serve an app built for base '/' from /opt/duk_pwa
    root /opt/duk_pwa;
    index index.html;

    # React Router
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache legacy assets. Never applies to /bus/ios/mobile/ (its `^~` prefix
    # skips regex locations), where it would cache sw.js for a year.
    location ~* \.(js|css|png|jpg|svg|woff|woff2|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ── Passenger PWA at /bus/ios/mobile/ ─────────────────────────────────────
    # Vite base '/bus/ios/mobile/'; push_to_server.sh rsyncs dist/ to
    # /opt/duk_pwa1/. Keep in sync with section 3 of nginx-pwa.conf (the
    # production 443 server), which explains each rule.
    location ^~ /bus/ios/mobile/ {
        alias /opt/duk_pwa1/;
        index index.html;
        try_files $uri $uri/ /bus/ios/mobile/index.html;

        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        # Hashed Vite output: 1 year, immutable, no SPA fallback.
        location ^~ /bus/ios/mobile/assets/ {
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        location = /bus/ios/mobile/sw.js {
            add_header Cache-Control "no-cache" always;
            add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        location = /bus/ios/mobile/firebase-messaging-sw.js {
            add_header Cache-Control "no-cache" always;
            add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        location = /bus/ios/mobile/manifest.webmanifest {
            types { application/manifest+json webmanifest; }
            add_header Cache-Control "no-cache" always;
            add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        # Un-hashed public/ files: 7 days.
        location ~* \.(?:png|webp|avif|jpe?g|gif|svg|ico|mp4|webm|woff2?)$ {
            add_header Cache-Control "public, max-age=604800";
            add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
        }
    }

    # Proxy /api/* requests to the Python backend
    location /api/ {
        proxy_pass http://127.0.0.1:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket proxy
    location /api/v1/ws/ {
        proxy_pass http://127.0.0.1:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}

# ── Admin Dashboard ───────────────────────────────────────────────────────────
server {
    listen ${ADMIN_PORT};
    server_name _;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json;

    # Serve the built React app from /opt/admin_dashboard
    root /opt/admin_dashboard;
    index index.html;

    # React Router
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache Admin assets
    location ~* \.(js|css|png|jpg|svg|woff|woff2|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Proxy /api/* requests to the Python backend
    location /api/ {
        proxy_pass http://127.0.0.1:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket proxy
    location /api/v1/ws/ {
        proxy_pass http://127.0.0.1:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
