# ─────────────────────────────────────────────────────────────────────────────
# DUK Bus Tracker — reverse proxy (TLS + rate limiting) EXAMPLE
#
# The prod deploy runs mega_gateway on the host with NO built-in TLS. Put this
# nginx (or a cloud LB / Cloudflare) in front of it to terminate TLS, rate-limit,
# and block direct access to the origin. Copy to /etc/nginx/sites-available/,
# fill in your domain + cert paths, then enable + reload.
#
# NOTE: contains NO secrets. Replace api.example.com and the cert paths.
# ─────────────────────────────────────────────────────────────────────────────

# Per-IP rate-limit zones (defence-in-depth; the app also rate-limits per-user).
#   general: normal API traffic.   auth: login/OTP (brute-force guard).
limit_req_zone $binary_remote_addr zone=general:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=auth:10m    rate=1r/s;
limit_conn_zone $binary_remote_addr zone=conns:10m;

# The gateway (adjust host:port to where mega_gateway binds on the box).
upstream duk_gateway {
    server 127.0.0.1:8000;
    keepalive 32;
}

# Redirect all HTTP → HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name api.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.example.com;

    # ── TLS (use certbot / your CA; keep private keys off the repo) ──
    ssl_certificate     /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;

    # ── Security headers (HSTS also set by the app in production) ──
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Cap request bodies (the app also enforces this).
    client_max_body_size 2m;
    limit_conn conns 20;

    # Auth/OTP endpoints — strict limit + short burst.
    location ~ ^/api/v1/(auth|admin/login) {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://duk_gateway;
        include /etc/nginx/proxy_params;
    }

    # WebSocket (live GPS) — needs upgrade headers, no buffering.
    location /api/v1/ws/ {
        proxy_pass http://duk_gateway;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;   # keep long-lived sockets open
    }

    # Everything else (the general API).
    location / {
        limit_req zone=general burst=40 nodelay;
        proxy_pass http://duk_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
