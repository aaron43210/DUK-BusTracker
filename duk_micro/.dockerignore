# Prevent `COPY . .` from baking secrets, local state, and bulk artifacts into
# the image layer. Anything matched here never enters the build context.

# ── Secrets / credentials (NEVER ship in an image) ──────────────────────────
.env
.env.*
!.env.example
*firebase*
*creds*
firebase_creds*.json
*.pem
*.key
*.p12
*.pfx

# ── VCS / tooling ───────────────────────────────────────────────────────────
.git
.gitignore
.dockerignore
.github
.vscode
.idea

# ── Python caches / local venvs ─────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/

# ── Bulk / regenerable artifacts ────────────────────────────────────────────
osrm-data/
models/
*.pkl
*.joblib
*.h5
*.onnx
logs/
*.log

# ── Tests / docs not needed at runtime ──────────────────────────────────────
tests/
test_*.py
*_test.py

# ── OS cruft ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
