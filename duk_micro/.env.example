# ─────────────────────────────────────────────────────────────────────────────
# DUK Bus Tracker Backend — Production Environment Variables
#
# INSTRUCTIONS:
#   1. Copy this file to /etc/duk/production.env on the server
#   2. Fill in all values marked as REQUIRED
#   3. Set file permissions: chmod 600 /etc/duk/production.env
#   4. Never commit this file to git (it's in .gitignore)
#
# Generate strong secrets with:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED: Update with your server's PostgreSQL credentials
DATABASE_URL=postgresql+asyncpg://duk_user:CHANGE_ME@localhost:5432/duk_bus

# ── Redis ─────────────────────────────────────────────────────────────────────
# REQUIRED (compose deploy): Redis now requires a password. The URL must carry it
# in the form redis://:PASSWORD@host:6379/0. For a local password-less dev Redis
# you can still use redis://localhost:6379/0.
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@localhost:6379/0

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -hex 32
SECRET_KEY=GENERATE_THIS_WITH_OPENSSL_RAND_HEX_32

# ── GPS Device ───────────────────────────────────────────────────────────────
# REQUIRED: The API key the hardware GPS device must send with each request
# The device should be configured to use this same key
GPS_API_KEY=CHANGE_ME_STRONG_GPS_KEY

# ── Admin Panel ───────────────────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -hex 32
ADMIN_TOKEN=GENERATE_THIS_WITH_OPENSSL_RAND_HEX_32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ── Email (OTP Delivery) ──────────────────────────────────────────────────────
# REQUIRED: Gmail app password (not your regular password)
# Create at: myaccount.google.com → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
SMTP_FROM=DUK Bus Tracker <your-email@gmail.com>

# ── Gmail API (preferred for @duk.ac.in / @iiitm.ac.in Workspace accounts) ──
# When GMAIL_SERVICE_ACCOUNT_PATH is set, Gmail API is used instead of SMTP.
# Requires: Google Cloud project with Gmail API enabled, service account JSON
# with domain-wide delegation granted in Google Workspace Admin console.
# Scope needed: https://www.googleapis.com/auth/gmail.send
GMAIL_SERVICE_ACCOUNT_PATH=/opt/duk_micro/gmail_service_account.json
GMAIL_SENDER_EMAIL=noreply@duk.ac.in

# ── Firebase Push Notifications ───────────────────────────────────────────────
# REQUIRED: From Firebase Console → Project Settings → Cloud Messaging
# FCM_SERVER_KEY: Legacy server key (for direct FCM v1 API calls)
FCM_SERVER_KEY=your-fcm-server-key-here
FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute path (inside the container) to the Firebase service-account JSON.
# The compose files mount the key here; the code reads THIS var to find it.
# Without it, get_firebase_app() finds nothing and ALL push notifications no-op.
FIREBASE_CREDENTIALS_PATH=/opt/duk_micro/firebase_creds.json

# ── CORS ──────────────────────────────────────────────────────────────────────
# REQUIRED: Set to your actual domain once IT provides it
# This controls which websites can call the API
ALLOWED_ORIGINS=https://YOUR_DOMAIN_HERE

# ── OSRM ──────────────────────────────────────────────────────────────────────
# Local OSRM instance running in Docker (see deploy/osrm-setup.sh)
OSRM_URL=http://127.0.0.1:5001
# With ENVIRONMENT=production, loopback Redis/OSRM URLs are rejected unless this
# is true (set automatically by docker-compose.prod.yml for host networking).
# ALLOW_LOOPBACK_SERVICES=false

# ── Security ──────────────────────────────────────────────────────────────────
# Reverse proxies allowed to set X-Forwarded-For (comma-separated IPs or CIDR).
# Must include the address the proxy connects FROM, or every client shares the
# proxy's rate-limit bucket. Root docker-compose.yml sets 172.16.0.0/12 for
# Traefik; for host-network nginx on the same machine the default is enough.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# Comma-separated list of allowed sign-up/login email domains (name must be plural
# to match settings.ALLOWED_EMAIL_DOMAINS — the singular form is silently ignored).
ALLOWED_EMAIL_DOMAINS=duk.ac.in

# Refresh-token rotation grace window (seconds). On /refresh a new refresh token
# is issued and the old one is accepted for this brief overlap so concurrent
# mobile refreshes don't race into a logout. Sessions stay long-lived (365 days);
# this only hardens revocation. Leave UNSET (comment this line out) to use the
# built-in default of 60. Do NOT leave it as an empty value — an empty string
# fails int parsing at startup. Set an explicit integer, or keep it commented.
# REFRESH_TOKEN_GRACE_SECONDS=60

# ── Docker Compose (root docker-compose.yml only) ─────────────────────────────
# These are read ONLY by the root docker-compose.yml and are REQUIRED there —
# compose fails to start if either is unset (fail-closed; no weak fallback).
#
# POSTGRES_PASSWORD: password for the bundled Postgres container. Must match the
#   password embedded in DATABASE_URL above.
# REDIS_PASSWORD: password for the bundled Redis container. Must match the
#   password embedded in REDIS_URL above (redis://:PASSWORD@redis:6379/0).
# POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
