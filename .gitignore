# Original rules

.DS_Store

# Secrets & Environment Variables (Keep .env.example if exists)
.env
.env.*
!.env.example
*.pem
*.key
google-services.json
firebase.txt

# Node modules & dependencies
node_modules/
npm-debug.log
yarn-error.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/

# Vite/Build tools
.vite/
dist/
build/
out/
coverage/

# OS/Editor
Thumbs.db
.vscode/
.idea/
postgres_data/

# Audit reports & session notes (never push these)
AUDIT_REPORT*.md
DEEP_AUDIT_REPORT*.md
AGENT.md
CHANGES.md
architecture.html

# GPS firmware sketches (hardware repo, not server)
*.ino

# Local SQLite databases
*.db

# Local Firebase credentials (use /opt/duk_micro/firebase_creds.json on server)
firebase_creds.local.json
duk_micro/firebase_creds.local.json

# OSRM raw map data (large, regenerated by osrm-setup.sh on server)
duk_micro/osrm-data/trivandrum*.osm
duk_micro/osrm-data/trivandrum*.osrm*
duk_micro/osrm-data/*.pbf

# archify tool (third-party, not part of the project)
archify/
