# Database connection (PostgreSQL / Supabase / SQLite)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/bustracker

# Security keys & tokens
SECRET_KEY=change_me_in_production_secret_key
GPS_API_KEY=your_gps_api_key_here
ADMIN_TOKEN=your_admin_token_here

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# SMTP Configuration (Optional - for email notifications/OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM=DUK Bus Tracker <your_email@example.com>

# Firebase Cloud Messaging (FCM) Configuration (Optional - for push notifications)
FCM_SERVER_KEY=your_fcm_server_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id
